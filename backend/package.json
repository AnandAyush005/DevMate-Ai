{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "bun run --watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "start": "bun run src/server.ts",
    "test": "node --experimental-transform-types --experimental-test-module-mocks --import ./tests/resolve-js-imports.mjs --test \"tests/unit/**/*.test.ts\"",
    "db:migrate": "prisma db migrate",
    "db:update": "prisma db update",
    "db:plan": "prisma migration plan",
    "db:status": "prisma migration status",
    "db:emit": "prisma contract emit",
    "postinstall": "sh -c 'test \"$VERCEL\" = \"1\" && exit 0 || (prisma skills sync || exit 0)'"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@ai-sdk/google": "^4.0.124",
    "@ai-sdk/groq": "^4.0.86",
    "@prisma/orm-postgres": "^8.0.0-rc.12",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "ai": "^7.0.179",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "nodemailer": "^10.6.0",
    "prisma": "^8.0.0-rc.17",
    "process": "^0.11.10",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "typescript": "^6.0.3"
  }
